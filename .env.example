# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="GateForge Gateway"

# Security
SECRET_KEY=dev-secret-key-please-change-in-production-min-32-chars-long
API_KEY_PREFIX=gfg_live_

# PostgreSQL Database (Asyncpg Driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gateforge
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=30

# Redis Cache & Sliding Window Limiter
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
AUTH_CACHE_TTL_SECONDS=300

# Rate Limiter Tier Quotas (Requests per Minute)
RATE_LIMIT_FREE_RPM=60
RATE_LIMIT_PRO_RPM=600
RATE_LIMIT_ENTERPRISE_RPM=6000
