# ==============================================================================
# GateForge Gateway - Environment Configuration Reference
# ==============================================================================

# Core Application Settings
PROJECT_NAME="GateForge API Gateway"
ENVIRONMENT="development"
DEBUG=false

# PostgreSQL Database Connection
DATABASE_URL="postgresql+asyncpg://gateforge:gateforge_secret@localhost:5432/gateforge_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# Redis Cache & Sliding-Window Rate Limiting
REDIS_URL="redis://localhost:6379/0"
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
AUTH_CACHE_TTL_SECONDS=300
AUTH_CACHE_JITTER_SECONDS=30

# Rate Limiting Policies
DEFAULT_RATE_LIMIT_RPM=60
SLIDING_WINDOW_WINDOW_SECONDS=60

# Background Telemetry Flusher
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL_SECONDS=1.0
TELEMETRY_QUEUE_MAX_SIZE=10000
